+                                  device=parameter.device)
+    allocation.host.copy_(parameter.detach(), non_blocking=False)
+    # Preserve the Parameter object and its loader/sharding attributes.
+    parameter.data = allocation.cuda
+    model._mapped_input_embedding = allocation
