+"""Compact a vision SwiGLU result into already-consumed projection storage."""
+import torch
+import torch.nn.functional as F
+
+
+def swiglu(projected):
+    if torch.is_grad_enabled() or torch.is_autocast_enabled() or not projected.is_contiguous():
+        gate, up = projected.chunk(2, dim=-1)
+        return F.silu(gate) * up
+    width = projected.shape[-1] // 2
+    source = projected.view(-1, width * 2)
+    rows = source.shape[0]
+    packed = projected.view(-1)[:rows * width].view(rows, width)
+    first = 0
+    while first < rows:
+        # Output rows [first,last) overwrite source rows below first. The
+        # initial row is safe after SiLU has read its gate; later blocks obey
+        # last <= 2*first, so no unread source row can be overwritten.
+        count = 1 if first == 0 else min(first, 512)
+        last = min(rows, first + count)
+        activated = F.silu(source[first:last, :width])
+        torch.mul(activated, source[first:last, width:], out=packed[first:last])
+        del activated
+        first = last
+    return packed.view(*projected.shape[:-1], width)
