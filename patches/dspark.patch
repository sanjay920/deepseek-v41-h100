+"""Bound only eager W4A16 expert workspace; retain routed IDs, scales and outputs."""
+import os
+import torch
+
+
+def run(function, **kwargs):
+    x = kwargs['input']
+    limit = int(os.environ.get('DSV41_EXPERT_PREFILL_CHUNK', '0'))
+    eligible = (
+        limit > 0 and x.shape[0] > limit
+        and x.dtype == torch.bfloat16
+        and kwargs.get('input_sf') is None
+        and kwargs.get('use_w4_group_scaling', False)
+        and not kwargs.get('use_mxfp8_act_scaling', False)
+        and not kwargs.get('use_wfp4afp8_humming', False)
+        and not kwargs.get('enable_alltoall', False)
+        and not torch.cuda.is_current_stream_capturing()
+    )
+    if not eligible:
+        return function(**kwargs)
+    out = kwargs['output']
+    assert out.shape[0] == x.shape[0]
+    for first in range(0, x.shape[0], limit):
+        last = min(first + limit, x.shape[0])
+        part = dict(kwargs)
+        for key in ('input', 'token_selected_experts', 'token_final_scales', 'output'):
+            part[key] = kwargs[key][first:last]
+        part['tune_max_num_tokens'] = 1 << (last - first - 1).bit_length()
+        function(**part)
+    # The MXFP4 caller supplies the output buffer and ignores the return value.
+    return None
