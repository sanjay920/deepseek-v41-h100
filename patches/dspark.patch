+"""Task-scoped host KV storage with a non-owning CUDA tensor view.
+
+The pool must retain HostKVAllocation while its CUDA view or captured graphs are
+in use. Data stays in pinned host RAM; constructing this view does not copy it.
+"""
+import math
+import torch
+from cuda.bindings import runtime as cudart
+
+
+class HostKVAllocation:
+    def __init__(self, shape, *, dtype=torch.uint8, device=None):
+        requested=torch.device(device) if device is not None else torch.device('cuda')
+        assert requested.type=='cuda'
+        self.device=torch.device('cuda',requested.index if requested.index is not None else torch.cuda.current_device())
+        self.host=torch.zeros(tuple(shape),dtype=dtype,device='cpu',pin_memory=True)
+        status,pointer=cudart.cudaHostGetDevicePointer(self.host.data_ptr(),0)
+        if status!=cudart.cudaError_t.cudaSuccess:
+            raise RuntimeError(f'cudaHostGetDevicePointer: {status}')
+        storage=torch._C._construct_storage_from_data_pointer(
+            int(pointer),self.device,self.host.numel()*self.host.element_size())
+        self.cuda=torch.empty(0,dtype=dtype,device=self.device).set_(
+            storage,0,tuple(shape))
+        # Retain the allocation even when a caller retains only this root view.
+        self.cuda._host_kv_owner=self.host
+        assert self.cuda.is_cuda and self.cuda.shape==self.host.shape
