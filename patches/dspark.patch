+        return
+    assert not model.config.tie_word_embeddings
+    parameter = model.model.embed_tokens.weight
+    assert parameter is not model.lm_head.weight
+    assert parameter.is_cuda and parameter.dtype in (torch.bfloat16, torch.float16)
