+"""Copy only selected packed KV rows to GPU memory, preserving byte order."""
+import torch
+import triton
+import triton.language as tl
+
+
+@triton.jit
+def _gather_packed_rows(src,ids,dst,N:tl.constexpr,PAGE:tl.constexpr,
+                        SOURCE_STRIDE:tl.constexpr,DEST_STRIDE:tl.constexpr,
+                        WIDTH:tl.constexpr,BLOCK:tl.constexpr):
+    row=tl.program_id(0)
+    byte=tl.arange(0,BLOCK)
+    token=tl.load(ids+row).to(tl.int64)
+    # A page stores all 576-byte payloads, then all 8-byte scale records.
+    offset=(token//PAGE)*SOURCE_STRIDE+tl.where(
+        byte<576,(token%PAGE)*576+byte,PAGE*576+(token%PAGE)*8+byte-576)
+    target=(row//PAGE)*DEST_STRIDE+tl.where(
+        byte<576,(row%PAGE)*576+byte,PAGE*576+(row%PAGE)*8+byte-576)
+    value=tl.load(src+offset,mask=(byte<WIDTH)&(token>=0),other=0)
+    tl.store(dst+target,value,mask=byte<WIDTH)
+
