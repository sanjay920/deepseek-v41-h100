+"""Compact the storage backing sparse prefill without changing key order."""
+import torch
+
+
+def compact_prefill_gather(compressed_ids, swa_ids, indices):
+    count = compressed_ids.numel()
+    if count == 0:
+        return compressed_ids, swa_ids, indices
+    unique, inverse = torch.unique(indices.reshape(-1), sorted=True, return_inverse=True)
+    # Negative indices retain an unused dummy entry in the compact store.
+    # Sorted unique indices put compressed entries before SWA entries, matching
+    # the order in which the caller fills the compact workspace.
+    compressed_columns = unique[unique < count].clamp_min(0).long()
+    swa_columns = (unique[unique >= count] - count).long()
+    remapped = inverse.reshape(indices.shape).to(indices.dtype)
+    remapped = torch.where(indices >= 0, remapped, indices)
+    return compressed_ids[compressed_columns], swa_ids[swa_columns], remapped
