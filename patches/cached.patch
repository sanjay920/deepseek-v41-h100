+        q, weights, slots, lens.to(torch.int64).contiguous(), table, out,
+        length, page_size, table.stride(0), q.stride(0), q.stride(1), weights.stride(0),
+        candidate_mask, candidate_mask.stride(0), H=h, HALF_D=64, BLOCK_L=64, num_warps=4,
