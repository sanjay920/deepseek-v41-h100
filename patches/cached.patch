+def fp4_index_logits_decode(q, weights, slots, lens, table, page_size, candidate_mask=None):
+    # Keep the ordinary scorer for source layers, prefill, and short contexts.
+    if candidate_mask is None or slots.shape[1] < 65536:
+        return _fp4_index_logits_decode_unmasked(q, weights, slots, lens, table, page_size)
